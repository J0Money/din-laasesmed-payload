# Variabler til e-mail fra formularerne. Uden SMTP_HOST skrives mails kun til konsollen.
# Sættes som Variables på web-servicen i Railway (aldrig i git).
SMTP_HOST=
SMTP_PORT=587
# "true" ved port 465, ellers false
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Afsender på mailene. Skal være en adresse, SMTP-udbyderen må sende fra (domænet skal være verificeret).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Din Låsesmed
# Sitets offentlige adresse (sitemap og delings-billeder)
SITE_URL=https://din-laasesmed.dk
